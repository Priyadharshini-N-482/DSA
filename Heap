//Heap-add,remove,peek,size(default-Minheap)
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		PriorityQueue<Integer>pq=new PriorityQueue<>();
		pq.add(10);pq.add(20);pq.add(-30);
		System.out.println(pq.peek());//-30
		pq.add(35);
		System.out.println(pq.peek());//-30
		System.out.println(pq.size());//4
		System.out.println(pq.remove());//-30
		System.out.println(pq.peek());//10
		System.out.println(pq);//[10,20,35]
		pq.add(5);
		pq.add(8);
		pq.add(2);
		pq.add(0);
		pq.add(3);
		pq.add(1);
		pq.add(7);
		pq.add(6);
		System.out.println(pq);//[0,1,2,3,6,35,5,20,8,10,7]-level order 
	}
}
//Kth-smallest element using maxheap
import java.util.*;
public class Main
{
    static int kthsmallestelement(int[]arr,int k){
        PriorityQueue<Integer>pq=new PriorityQueue<>(Collections.reverseOrder());
        for(int ele:arr){
            pq.add(ele);
            if(pq.size()>k)pq.remove();
        }
        return pq.peek();
    }
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
	    int k=sc.nextInt();//3
	    int[] arr={7,10,4,3,20,15};
	    System.out.println(kthsmallestelement(arr,k));//7
	}
}
//Kth-largest element using minheap
import java.util.*;
public class Main
{
    static int kthlargestelement(int[]arr,int k){
        PriorityQueue<Integer>pq=new PriorityQueue<>();
        for(int ele:arr){
            pq.add(ele);
            if(pq.size()>k)pq.remove();
        }
        return pq.peek();
    }
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
	    int k=sc.nextInt();//2
	    int[] arr={7,10,4,3,20,15};//15
	    System.out.println(kthlargestelement(arr,k));
	}
}



