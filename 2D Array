		        arr[j][i]=t;
		    }
		}
		for(int i=0;i<arr.length;i++){
		    int sc=0,ec=arr[0].length-1;
		    while(sc<ec){
		        int te=arr[i][sc];
		        arr[i][sc]=arr[i][ec];
		        arr[i][ec]=te;
		        sc++;
		        ec--;
		    }
		}
